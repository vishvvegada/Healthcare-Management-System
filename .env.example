# ==============================================================================
# Supabase Configuration
# ==============================================================================
# Find these values in your Supabase Dashboard:
# Go to: Project Settings -> API (or API Keys)

# Supabase Project URL (Client & Server)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Public Anon Key (Client & Server)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Supabase Service Role Key (Server-side ONLY - Keep Secret!)
# Required for Super Admin setup (/setup) and patient user registration (/signup)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
